rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Chỉ cho phép tạo tài liệu mới trong collection "donhang"
    // Cấm đọc, sửa, xóa từ trình duyệt
    match /donhang/{orderId} {
      allow create: if true;
      allow read, update, delete: if false;
    }

    // Mặc định cấm đọc/ghi toàn bộ các đường dẫn còn lại
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
